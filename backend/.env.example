API_HOST=0.0.0.0
API_PORT=8081

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# Intent routing only; use a small fast model so replies start sooner (set equal to OPENROUTER_DEFAULT_MODEL to use one model).
OPENROUTER_INTENT_MODEL=openai/gpt-4o-mini
# DeepSeek 思考模式要求回传 reasoning_content，与 LangChain 的多轮工具调用不兼容，
# 默认关闭；改用 DeepSeek 又想开推理时设为 true。
CHAT_THINKING_MODE=false

DATABASE_URL=
DATABASE_ECHO_SQL=false
# A chat request holds its session for the whole SSE stream, so a tiny pool
# serialises everything and ends in "QueuePool limit ... reached".
# Lower to 1/0 only when pointing at a strict session pooler (e.g. Supabase :5432).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=3600
INIT_DB_SCHEMA_ON_STARTUP=false

JWT_SECRET=

# 163 邮箱授权码登录（IMAP 收信 / SMTP 发信）。
# 需要在 163 邮箱网页版“设置 → POP3/SMTP/IMAP”中开启 IMAP/SMTP 并生成授权码。
MAIL163_EMAIL=
MAIL163_EMAIL_AUTH_CODE=
MAIL163_SMTP_HOST=smtp.163.com
MAIL163_SMTP_PORT=465
MAIL163_IMAP_HOST=imap.163.com
MAIL163_IMAP_PORT=993
MAIL163_EMAIL_TIMEOUT_SECONDS=10

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8081/calendar/callback

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8081/notion/callback

# Internal integration token (start with ntn_). Optional: when set, notion_agent
# can search and write without going through OAuth. The integration must be
# explicitly shared with each page/database it should access.
NOTION_API_KEY=

FRONTEND_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379/0

VOYAGEAI_API_KEY=
VOYAGEAI_MODEL=voyage-3

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TRANSCRIPTION_MODEL=FunAudioLLM/SenseVoiceSmall

EDGE_TTS_VOICE=en-US-JennyNeural

# LangSmith (optional) — set tracing + API key to record LangGraph / LLM traces
# LANGSMITH_TRACING_V2=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=chief-of-staff
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional Gmail list tuning (matches config.py defaults)
# GMAIL_LIST_MAX_RESULTS=100
# GMAIL_LIST_MAX_TOTAL_MESSAGES=2000
# GMAIL_LIST_MAX_ENRICHED=500
# GMAIL_LIST_ENRICH_CONCURRENCY=10


# Web search (Tavily) - travel guides / latest info
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# Maps / weather (Amap recommended in mainland China)
AMAP_API_KEY=
WEATHER_PROVIDER=amap
MAP_PROVIDER=amap
